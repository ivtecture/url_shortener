# Шаблон переменных окружения URL Shortener (см. docs/ARCHITECTURE.md, раздел 7.3)
# Скопируйте в .env и при необходимости поправьте: cp .env.example .env

# Путь к файлу SQLite на docker-томе.
# ВАЖНО: значение одинаково для активного Go-сервиса (v2) и legacy-Python —
# они смонтированы на один том. Одновременная запись в один файл SQLite
# не поддерживается, см. docs/ARCHITECTURE.md, раздел 9 (риск №2).
DATABASE_PATH=/data/urlshortener.db

# Подключение к Redis
REDIS_URL=redis://redis:6379/0

# Шаблон гео-запроса ({ip} подставляется автоматически)
GEO_API_URL=http://ip-api.com/json/{ip}?fields=status,countryCode

# Таймаут внешнего гео-запроса, сек
GEO_TIMEOUT_SECONDS=2

# TTL кэша редиректов url:{code}, сек (1 час)
CACHE_TTL_SECONDS=3600

# TTL кэша геолокации geo:{ip}, сек (24 часа)
GEO_CACHE_TTL_SECONDS=86400

# База для сборки short_url в ответах API
BASE_URL=http://localhost

# Пул рекламных баннеров: строки вида <файл>|<ссылка>|<вес>.
# Вес задаёт относительную частотность показа (по умолчанию 1).
AD_IMAGES_FILE=/static/ads/ad_images.txt

# Подписи под баннером, по строке на файл
AD_TEXTS_FILE=/static/ads/ad_texts.txt

# Период сброса буфера метрик рекламы в SQLite, сек
AD_FLUSH_INTERVAL_SECONDS=5

# Шаблон страницы перехода с рекламой (правится без пересборки)
ROUTING_PAGE_FILE=/templates/routing_page.html
