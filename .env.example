# Шаблон переменных окружения: скопируйте в .env при локальном запуске.
# В docker-compose.yml значения заданы по умолчанию.

# --- инфраструктура ---
DATABASE_PATH=/data/urlshortener.db
REDIS_URL=redis://redis:6379/0
BASE_URL=http://localhost

# --- кэш ---
CACHE_TTL_SECONDS=3600

# --- геолокация ---
GEO_API_URL=http://ip-api.com/json/{ip}?fields=status,countryCode
GEO_TIMEOUT_SECONDS=2
GEO_CACHE_TTL_SECONDS=86400

# --- временные ссылки (ветка temp-links) ---
DEFAULT_TTL_SECONDS=3600
MIN_TTL_SECONDS=60
MAX_TTL_SECONDS=604800
CLEANUP_INTERVAL_SECONDS=300
